# Free LLM API Keys (Choose either Gemini or Groq, or both)
# Google AI Studio free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider selection: "gemini" or "groq"
DEFAULT_LLM_PROVIDER=gemini

# Embedding Model (runs 100% locally on CPU/GPU without API key)
# Recommended options:
# - BAAI/bge-m3 (Dense + Sparse, 100+ languages)
# - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (Ultra fast, lightweight)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Qdrant Vector DB (Runs locally in-memory or persisted to disk)
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=health_guidelines
